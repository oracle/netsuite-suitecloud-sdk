{
	"name": "@oracle/suitecloud-cli",
	"version": "4.0.0",
	"license": "UPL-1.0",
	"description": "SuiteCloud CLI for Node.js",
	"keywords": [
		"NetSuite",
		"SDF",
		"SuiteApp",
		"SuiteCloud",
		"SuiteScripts"
	],
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/oracle/netsuite-suitecloud-sdk/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oracle/netsuite-suitecloud-sdk.git#master"
	},
	"main": "./src/suitecloud.js",
	"preferGlobal": true,
	"nsCompatibleVersion": "2027.1",
	"sdkDownloadUrl": "https://system.netsuite.com/download/suitecloud-sdk/27.1",
	"sdkFilename": "cli-2027.1.0.jar",
	"sdkSha256": "0123456789001234567890abcdefffffffffffffffffffffffffffffffffffff",
	"bin": {
		"suitecloud": "src/suitecloud.js"
	},
	"dependencies": {
		"@oracle/suitecloud-sdk-core": "1.0.0",
		"chalk": "5.6.2",
		"cli-spinner": "0.2.10",
		"commander": "15.0.0",
		"inquirer": "14.0.2",
		"xml2js": "0.6.2"
	},
	"bundleDependencies": [
		"@oracle/suitecloud-sdk-core"
	],
	"devDependencies": {
		"copy-webpack-plugin": "^13.0.1",
		"jest": "30.5.1",
		"postject": "^1.0.0-alpha.6",
		"webpack": "^5.109.2",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"build": "webpack --config webpack.config.js",
		"build:single": "webpack --config webpack.single.config.js",
		"build:exe": "npm run build:single && node scripts/build-sea.js",
		"test": "jest",
		"postinstall": "node postinstall.js"
	}
}
