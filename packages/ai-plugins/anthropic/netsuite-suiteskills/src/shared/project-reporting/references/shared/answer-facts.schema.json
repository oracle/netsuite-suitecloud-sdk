{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Optional selection of one or two already-sourced scalar values for a compact answer.",
  "items": {
    "additionalProperties": false,
    "properties": {
      "definition": {
        "minLength": 1,
        "type": "string"
      },
      "denominator": {
        "minimum": 0,
        "type": [
          "number",
          "null"
        ]
      },
      "evidence_path": {
        "pattern": "^/",
        "type": "string"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "label": {
        "minLength": 1,
        "type": "string"
      },
      "limitations": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "obligation_id": {
        "minLength": 1,
        "type": "string"
      },
      "provenance": {
        "enum": [
          "observation",
          "calculation",
          "native",
          "proposed"
        ]
      },
      "source_refs": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "unit": {
        "minLength": 1,
        "type": "string"
      },
      "value_type": {
        "enum": [
          "number",
          "decimal",
          "count",
          "date",
          "status",
          "presence"
        ]
      }
    },
    "required": [
      "definition",
      "evidence_path",
      "id",
      "label",
      "obligation_id",
      "source_refs",
      "unit",
      "value_type"
    ],
    "type": "object"
  },
  "maxItems": 2,
  "minItems": 1,
  "title": "ANSWER-FACTS-1.0",
  "type": "array"
}
