{
	"$schema": "../../schemas/plugin-build.schema.json",
	"id": "netsuite-suitecloud",
	"version": "1.0.0",
	"platform": "anthropic",
	"metadata": {
		"name": "netsuite-suitecloud",
		"displayName": "NetSuite SuiteCloud",
		"description": "This plug-in includes skills that support key areas of SuiteCloud development, such as SuiteScript, SDF, UIF SPAs, security, permissions, documentation, modernization, and SAFE Guide best practices. It helps SuiteCloud developers and SuiteApp teams create accurate, secure, and maintainable code and project artifacts.",
		"author": {
			"name": "Oracle NetSuite",
			"url": "https://www.netsuite.com"
		},
		"license": "The Universal Permissive License (UPL), Version 1.0",
		"keywords": [
			"netsuite",
			"suitecloud",
			"suitescript",
			"sdf",
			"uif"
		],
		"homepage": "https://github.com/oracle/netsuite-suitecloud-sdk/tree/ai-plugins-dist/anthropic/netsuite-suitecloud",
		"repository": "https://github.com/oracle/netsuite-suitecloud-sdk"
	},
	"skills": [
		"netsuite-owasp-secure-coding",
		"netsuite-sdf-project-documentation",
		"netsuite-sdf-roles-and-permissions",
		"netsuite-sdf-safe-guide",
		"netsuite-suitescript-learning",
		"netsuite-suitescript-records-reference",
		"netsuite-suitescript-upgrade",
		"netsuite-uif-spa-reference"
	],
	"commonLayers": [],
	"inputs": [
		{
			"root": "src",
			"destination": ".",
			"include": [
				"README.md"
			],
			"exclude": []
		}
	]
}