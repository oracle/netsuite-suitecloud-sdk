{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "action"
          }
        }
      },
      "then": {
        "required": [
          "proposed_action",
          "execution_state",
          "recheck"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "kpi"
          }
        }
      },
      "then": {
        "required": [
          "value",
          "unit",
          "period",
          "definition"
        ]
      }
    }
  ],
  "properties": {
    "as_of": {
      "type": "string"
    },
    "authorization": {
      "type": [
        "object",
        "null"
      ]
    },
    "definition": {
      "type": [
        "string",
        "null"
      ]
    },
    "denominator": {
      "type": [
        "number",
        "null"
      ]
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_date_basis": {
      "enum": [
        "recorded",
        "proposed",
        "not supplied"
      ]
    },
    "execution_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "kpi",
        "action",
        "coverage"
      ]
    },
    "limitations": {
      "type": "array"
    },
    "native_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "period": {
      "type": "string"
    },
    "proposed_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "proposed_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "recheck": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk_severity": {
      "enum": [
        "High",
        "Medium",
        "Low",
        "Unrated",
        null
      ]
    },
    "scope": {
      "type": "string"
    },
    "source_refs": {
      "minItems": 1,
      "type": "array"
    },
    "state": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "number",
        "string",
        "null"
      ]
    }
  },
  "required": [
    "kind",
    "title",
    "scope",
    "as_of",
    "source_refs",
    "state",
    "limitations"
  ],
  "title": "Evidence-backed project card",
  "type": "object"
}
