                },
                "type": "array",
                "uniqueItems": true
              },
              "not_applicable": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "unavailable": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "unresolved": {
                "items": {
                  "minLength": 1,
