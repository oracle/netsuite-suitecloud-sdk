              },
              "expected_members": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "fields": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "method": {
                "enum": [
                  "temporal",
                  "ownership",
                  "reconciliation",
                  "workflow",
                  "requirement",
                  "relationships"
                ]
              },
              "population_unit": {
                "enum": [
                  "projects",
                  "resources"
                ]
              },
              "project_ids": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "resource_keys": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "window": {
                "minProperties": 1,
                "type": "object"
              }
            },
            "required": [
              "id",
              "area",
              "method",
              "definition",
              "grain",
              "source_definition_ref",
              "project_ids",
              "resource_keys",
              "population_unit",
              "expected_members",
              "fields",
              "window"
            ],
            "type": "object"
          },
          "evidence_refs": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "partitions": {
            "properties": {
              "evaluated": {
                "items": {
                  "minLength": 1,
