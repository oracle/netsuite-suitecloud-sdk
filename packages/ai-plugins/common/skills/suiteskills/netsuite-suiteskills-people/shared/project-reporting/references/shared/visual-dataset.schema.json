{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "allOf": [
          {
            "$ref": "card.schema.json"
          },
          {
            "properties": {
              "control": {
                "const": "display_only"
              },
              "kind": {
                "const": "action"
              }
            },
            "required": [
              "control"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "cards": {
      "items": {
        "allOf": [
          {
            "$ref": "card.schema.json"
          },
          {
            "properties": {
              "lineage": {
                "required": [
                  "formula",
                  "grain",
                  "filters",
                  "input_row_refs",
                  "context",
                  "source_refs"
                ],
                "type": "object"
              },
              "population_basis": {
                "enum": [
                  "scoped_evaluated",
                  "known_subset"
                ]
              },
              "provenance": {
                "enum": [
                  "observation",
                  "calculation",
                  "native",
                  "proposed"
                ]
              }
            },
            "required": [
              "id",
              "lineage",
              "provenance",
              "population_basis"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 5,
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "coverage": {
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "obligations": {
          "type": "array"
        },
        "request_gate": {
          "type": [
            "object",
            "null"
          ]
        },
        "risk_gate": {
          "type": [
            "object",
            "null"
          ]
        },
        "risk_rows": {
          "type": "array"
        },
        "source_checks": {
          "type": "array"
        },
        "state": {
          "enum": [
            "Complete",
            "Limited",
            "Incomplete",
            "Plan only"
          ]
        }
      },
      "required": [
        "state",
        "errors",
        "request_gate",
        "risk_gate",
        "source_checks",
        "obligations",
        "risk_rows"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "owner": {
      "enum": [
        "project-portfolio-health-assistant",
        "project-operations-assistant",
        "project-risk-assistant",
        "project-financial-assistant"
      ]
    },
    "panels": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "chart": {
            "type": [
              "object",
              "null"
            ]
          },
          "columns": {
            "items": {
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "context": {
            "type": "object"
          },
          "definition": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "filters": {
            "type": "array"
          },
          "grain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "table",
              "bar",
              "comparison",
              "timeline",
              "matrix"
            ]
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rows": {
            "items": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "provenance": {
                        "const": "calculation"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "lineage": {
                        "properties": {
                          "formula": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "input_row_refs": {
                            "type": "array"
                          }
                        },
                        "required": [
                          "formula",
                          "input_row_refs"
                        ],
                        "type": "object"
                      }
                    }
                  }
                }
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "lineage": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "provenance": {
                  "enum": [
                    "observation",
                    "calculation",
                    "native",
                    "proposed"
                  ]
                },
                "source_refs": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "values": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "values",
                "source_refs",
                "provenance",
                "lineage"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "source_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "title": {
            "type": "string"
          },
          "window": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "description",
          "state",
          "columns",
          "rows",
          "source_refs",
          "chart",
          "limitations",
          "definition",
          "grain",
          "filters",
          "context",
          "window"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "profile": {
      "enum": [
        "portfolio-health",
        "operations",
        "operations-sow",
        "risk",
        "financial"
      ]
    },
    "requested_recipe": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_contract": {
      "const": "PM-4.0.0"
    },
    "selection": {
      "properties": {
        "kind": {
          "const": "display_subset_only"
        },
        "root_population_unchanged": {
          "const": true
        }
      },
      "required": [
        "kind",
        "root_population_unchanged"
      ],
      "type": "object"
    },
    "snapshot": {
      "properties": {
        "as_of": {
          "type": "string"
        },
        "context_fingerprint": {
          "type": "string"
        },
        "evaluation_times": {
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "request_signature": {
          "type": "string"
        },
        "scope": {
          "properties": {
            "exact_user": {
              "type": "object"
            },
            "label": {
              "type": "string"
            },
            "project_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "resource_keys": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "label",
            "project_ids",
            "resource_keys",
            "exact_user"
          ],
          "type": "object"
        },
        "source_identity": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "timezone": {
          "type": "string"
        },
        "window": {
          "properties": {
            "end": {
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "type": "string"
            },
            "start": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "label"
          ],
          "type": "object"
        }
      },
      "required": [
        "id",
        "synthetic",
        "as_of",
        "timezone",
        "scope",
        "window",
        "request_signature",
        "context_fingerprint",
        "source_identity",
        "evaluation_times"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "properties": {
          "evaluated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "filters": {
            "type": "array"
          },
          "grain": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pages_complete": {
            "type": "boolean"
          },
          "periods_complete": {
            "type": "boolean"
          },
          "reference": {
            "type": "string"
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "enum": [
              "not_probed",
              "listed",
              "schema_verified",
              "read_verified",
              "denied",
              "tool_missing",
              "feature_absent_confirmed",
              "incompatible",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "reference",
          "fields",
          "grain",
          "filters",
          "retrieved_at",
          "evaluated_at",
          "pages_complete",
          "periods_complete",
          "state",
          "limitations"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "visual_version": {
      "const": "VISUAL-2.0.0"
    }
  },
  "required": [
    "visual_version",
    "runtime_contract",
    "profile",
    "owner",
    "title",
    "snapshot",
    "sources",
    "coverage",
    "cards",
    "panels",
    "actions",
    "limitations",
    "selection",
    "requested_recipe",
    "content_sha256"
  ],
  "title": "Evidence-backed visual dataset VISUAL-2.0.0 (package format, not NetSuite API)",
  "type": "object"
}
