{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "const": "PM-4.0.0"
    },
    "limitations": {
      "type": "array"
    },
    "mode": {
      "enum": [
        "facts_only",
        "render_only",
        "substantive",
        "authorized_action",
        "document_draft"
      ]
    },
    "owner": {
      "enum": [
        "project-portfolio-health-assistant",
        "project-operations-assistant",
        "project-risk-assistant",
        "project-financial-assistant"
      ]
    },
    "required_evidence": {
      "type": "array"
    },
    "result": {
      "type": "object"
    },
    "root_request_signature": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "source_refs": {
      "type": "array"
    },
    "window": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "root_request_signature",
    "mode",
    "owner",
    "scope",
    "window",
    "required_evidence",
    "result",
    "limitations",
    "source_refs"
  ],
  "title": "PM v3 handoff",
  "type": "object"
}
