{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Protected source-normalized evidence. Extra raw fields never enter the primary publication allowlist. Runtime checks impose per-domain stages, actual source receipts, unique IDs, arithmetic and disclosure. v12 requires exact request/session PM resolution, independent directory accounting and explicit filters. No busiest-book or date-only default exclusions.",
  "properties": {
    "coverage": {
      "items": {
        "properties": {
          "source_refs": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "state": {
            "enum": [
              "complete",
              "unavailable",
              "not_applicable"
            ]
          }
        },
        "required": [
          "stage",
          "state",
          "source_refs"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "domain": {
      "enum": [
        "health",
        "operations",
        "risk",
        "financial"
      ]
    },
    "pm_scope": {
      "properties": {
        "directory": {
          "properties": {
            "evaluated": {
              "minimum": 0,
              "type": "integer"
            },
            "expected": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "pages_complete": {
              "type": "boolean"
            },
            "periods_complete": {
              "type": "boolean"
            },
            "source_refs": {
              "minItems": 1,
              "type": "array"
            },
            "state": {
              "enum": [
                "complete",
                "unavailable"
              ]
            },
            "unavailable": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "expected",
            "evaluated",
            "unavailable",
            "pages_complete",
            "periods_complete",
            "source_refs"
          ],
          "type": "object"
        },
        "explicit_filters": {
          "items": {
            "properties": {
              "applied": {
                "const": true
              }
            },
            "required": [
              "name",
              "request_basis",
              "applied"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "all_accessible",
            "named",
            "authenticated"
          ]
        },
        "requested_keys": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "resolved": {
          "items": {
            "properties": {
              "entity_type": {
                "enum": [
                  "employee",
                  "vendor"
                ]
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "match_basis": {
                "enum": [
                  "exact_reference",
                  "verified_directory_match",
                  "authenticated_reference"
                ]
              },
              "source_refs": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "request_key",
              "entity_type",
              "id",
              "match_basis",
              "source_refs"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "unresolved": {
          "items": {
            "properties": {
              "attempts": {
                "minItems": 1,
                "type": "array"
              },
              "reason": {
                "minLength": 1,
                "type": "string"
              },
              "remaining_usable_channels": {
                "const": []
              }
            },
            "required": [
              "request_key",
              "reason",
              "attempts",
              "remaining_usable_channels",
              "source_refs"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "version": {
          "const": "PM-SCOPE-1.0.0"
        }
      },
      "required": [
        "version",
        "mode",
        "requested_keys",
        "resolved",
        "unresolved",
        "directory",
        "explicit_filters"
      ],
      "type": "object"
    },
    "scope": {
      "properties": {
        "as_of": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "timezone",
        "as_of"
      ],
      "type": "object"
    },
    "sources": {
      "items": {
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "read_verified",
              "denied",
              "tool_missing",
              "incompatible",
              "unknown",
              "feature_absent_confirmed"
            ]
          }
        },
        "required": [
          "id",
          "state",
          "kind"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "const": "PRIMARY-2.0.0"
    }
  },
  "required": [
    "version",
    "domain",
    "scope",
    "sources",
    "coverage",
    "pm_scope"
  ],
  "title": "PRIMARY-2.0.0 scoped protected input",
  "type": "object"
}
