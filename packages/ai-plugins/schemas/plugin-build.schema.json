{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://oracle.example/schemas/plugin-build.schema.json",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"id",
		"version",
		"platform",
		"metadata",
		"skills",
		"commonLayers",
		"inputs"
	],
	"properties": {
		"id": {
			"type": "string",
			"pattern": "^[a-z0-9][a-z0-9-]*$"
		},
		"version": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
		},
		"platform": {
			"type": "string",
			"enum": [
				"anthropic",
				"openai"
			]
		},
		"metadata": {
			"type": "object",
			"additionalProperties": true,
			"required": [
				"name",
				"description",
				"author",
				"license",
				"keywords"
			],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"minLength": 1
				},
				"author": {
					"type": "object",
					"additionalProperties": true,
					"required": [
						"name"
					],
					"properties": {
						"name": {
							"type": "string",
							"minLength": 1
						},
						"url": {
							"type": "string",
							"format": "uri"
						}
					}
				},
				"license": {
					"type": "string",
					"minLength": 1
				},
				"keywords": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"homepage": {
					"type": "string",
					"format": "uri"
				},
				"repository": {
					"type": "string",
					"format": "uri"
				}
			}
		},
		"skills": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"commonLayers": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"inputs": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"root",
					"destination",
					"include",
					"exclude"
				],
				"properties": {
					"root": {
						"type": "string",
						"minLength": 1
					},
					"destination": {
						"type": "string"
					},
					"include": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					"exclude": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"platform": {
						"const": "openai"
					}
				},
				"required": [
					"platform"
				]
			},
			"then": {
				"properties": {
					"metadata": {
						"required": [
							"interface"
						],
						"properties": {
							"interface": {
								"type": "object",
								"additionalProperties": true,
								"required": [
									"displayName",
									"shortDescription",
									"longDescription",
									"developerName",
									"category",
									"websiteURL",
									"privacyPolicyURL",
									"logo",
									"composerIcon",
									"brandColor"
								],
								"properties": {
									"displayName": {
										"type": "string",
										"minLength": 1,
										"maxLength": 30
									},
									"shortDescription": {
										"type": "string",
										"minLength": 1
									},
									"longDescription": {
										"type": "string",
										"minLength": 1
									},
									"developerName": {
										"type": "string",
										"minLength": 1
									},
									"category": {
										"type": "string",
										"minLength": 1
									},
									"websiteURL": {
										"type": "string",
										"format": "uri"
									},
									"privacyPolicyURL": {
										"type": "string",
										"format": "uri"
									},
									"logo": {
										"type": "string",
										"minLength": 1
									},
									"composerIcon": {
										"type": "string",
										"minLength": 1
									},
									"brandColor": {
										"type": "string",
										"minLength": 1
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
